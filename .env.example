# PaperAI environment example.
# Copy this file to .env and fill secrets locally. Do not commit real API keys.

APP_NAME=PaperAI
APP_VERSION=1.0.0
DEBUG=true

# PostgreSQL exposed by Docker Compose for local administration.
DATABASE_URL=postgresql+asyncpg://postgres:paperai-local@localhost:5432/paperai
# 仅用于明确的本地/测试空库；生产环境必须保持 false 并使用 Alembic。
ALLOW_DEV_SCHEMA_CREATE=false

# Redis is configured for future/background features and Docker deployment.
REDIS_URL=redis://localhost:6379/0
REDIS_ANSWER_TASK_TTL_SECONDS=86400
REDIS_UPLOAD_TASK_TTL_SECONDS=604800

# JWT
SECRET_KEY=change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Built-in administrator. Set the real password only in your local .env.
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-password

# LLM provider: deepseek or openai-compatible provider supported by app/llm/client.py.
LLM_PROVIDER=deepseek

# DeepSeek-compatible chat model.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# OpenAI-compatible chat model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
OPENAI_BASE_URL=https://api.openai.com/v1

# Academic search. Semantic Scholar public search works without a key; an optional
# key receives a dedicated rate limit. Crossref is public; mailto enables its polite pool.
# arXiv remains the approved preprint/downloadable full-text source.
ACADEMIC_SEARCH_PRIMARY_PROVIDER=semantic_scholar
SEMANTIC_SCHOLAR_API_KEY=
CROSSREF_MAILTO=
SEARCH_TIMEOUT_SECONDS=15
SEARCH_MAX_RETRIES=1
SEARCH_MAX_ROUNDS=3
SEARCH_MAX_QUERIES_PER_ROUND=3
SEARCH_RESULT_LIMIT=10

# Vision model, currently used by image/table analysis paths.
VISION_MODEL=qwen-vl-max
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Embedding and storage.
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_STORE_PATH=./data/vectorstore
FILE_STORAGE_PATH=./data/papers
MAX_UPLOAD_SIZE=52428800

# Optional frontend setting.
# If unset, the frontend uses relative API paths. Configure Vite proxy or reverse proxy accordingly.
VITE_API_BASE_URL=
