[Unit]
Description=PaperAI Frontend Service
After=network.target paperai-backend.service
Wants=network.target paperai-backend.service

[Service]
Type=oneshot
User=ddd
Group=ddd
WorkingDirectory=/home/ddd/project/myAgent/frontend
Environment=NODE_ENV=production
Environment=PATH=/home/ddd/.nvm/versions/node/v24.16.0/bin:/usr/local/bin:/usr/bin:/bin
ExecStartPre=/home/ddd/.nvm/versions/node/v24.16.0/bin/npm run build
ExecStart=/usr/bin/cp -a /home/ddd/project/myAgent/frontend/dist/. /var/www/paperai/
RemainAfterExit=yes
StandardOutput=append:/home/ddd/project/myAgent/logs/frontend.log
StandardError=append:/home/ddd/project/myAgent/logs/frontend.log

[Install]
WantedBy=multi-user.target
