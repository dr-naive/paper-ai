{
  "name": "personal-assistant-rules",
  "version": "2.0.0",
  "description": "个人助手行为约束规则 - 用于约束 AI 回答行为，包括语言规范、降级禁令、权限边界、需求澄清、信息诚实、代码生成优化等规则。每次回答前自动检查合规性。",
  "author": "user",
  "trigger": {
    "type": "always",
    "description": "每次回答前自动执行"
  },
  "hooks": {
    "before_response": [
      {
        "mode": "auto",
        "description": "每次回答前自动检查合规性"
      }
    ],
    "before_code_generation": [
      {
        "mode": "auto",
        "description": "代码生成前检查技术栈和依赖"
      }
    ]
  },
  "entry": "checker.py",
  "permissions": {
    "filesystem": {
      "allowed_paths": ["/home/ddd/project/PaperAI"],
      "description": "只能在项目目录操作，禁止访问系统根目录"
    },
    "commands": {
      "allowed": ["read", "grep", "glob", "search"],
      "restricted": ["sudo", "apt", "yum", "pip install", "npm install -g"],
      "description": "禁止执行需要管理员权限的命令"
    }
  },
  "rules": [
    "no_unauthorized_downgrade",
    "chinese_response",
    "permission_check",
    "clarify_before_action",
    "honest_about_limitations",
    "tech_stack_confirmation",
    "code_style_consistency",
    "dependency_check",
    "type_safety",
    "naming_convention",
    "step_by_step",
    "incremental_modification",
    "code_reuse",
    "token_optimization"
  ]
}
