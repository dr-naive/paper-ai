[Unit]
Description=PaperAI Backend Service
After=network.target
Wants=network.target

[Service]
Type=exec
User=ddd
Group=ddd
WorkingDirectory=/home/ddd/project/myAgent
ExecStart=/home/ddd/project/myAgent/run_backend.sh
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
StandardOutput=append:/home/ddd/project/myAgent/logs/backend.log
StandardError=append:/home/ddd/project/myAgent/logs/backend.log
KillMode=process
KillSignal=SIGINT
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target